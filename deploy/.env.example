# Runtime environment for Careflow -> copy to /opt/apps/careflow/.env on the server
# (chmod 600). Never commit the real file. Avoid "$" in values (docker compose interpolates).
# Generate secrets with: openssl rand -hex 32

# ======================= Backend: required (app refuses to start without) =======================
# Shared Postgres 16 container on apps-net; database + user "careflow".
DATABASE_URL=postgresql://careflow:CHANGE_ME_DB_PASSWORD@shared-postgres:5432/careflow?schema=public
# REQUIRED: Redis (rate limiting, /health, BullMQ jobs, reminders). There is no Redis in the
# shared stack yet - provide one reachable on apps-net, e.g. redis://shared-redis:6379/1
REDIS_URL=redis://CHANGE_ME_REDIS_HOST:6379/1
# JWT signing secrets (>= 32 chars each, independent). GENERATE.
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_32
# HMAC pepper for OTP codes (>= 32 chars). GENERATE.
OTP_PEPPER=CHANGE_ME_openssl_rand_hex_32
# Must be false (or unset) in production - the API refuses to boot with DEMO_MODE=true.
DEMO_MODE=false

# ======================= Backend: URLs / proxy =======================
# Public frontend URL (payment return/IPN callbacks, PDF verification links, email links).
APP_URL=https://careflow.13.203.3.1.sslip.io
# Comma-separated origins allowed for CORS and state-changing requests (no spaces).
CORS_ORIGINS=https://careflow.13.203.3.1.sslip.io
# Trust private-network proxies (host Nginx -> Next.js -> API) so per-IP rate limits see the client IP.
TRUST_PROXY=loopback,linklocal,uniquelocal

# ======================= Backend: recommended =======================
# 64 hex chars (32 bytes, AES-256-GCM) for encrypting uploaded documents. GENERATE (openssl rand -hex 32).
# Without it, document uploads are rejected.
ATTACHMENT_ENCRYPTION_KEY=
# Default payment provider for bookings: stripe | bkash | sslcommerz. "demo" only works with DEMO_MODE=true,
# so booking an appointment FAILS in production until one provider below is configured.
PAYMENT_PROVIDER=
# Telemedicine provider: livekit (needs LIVEKIT_*); empty = demo.
TELEMEDICINE_PROVIDER=

# ======================= Third-party keys (provide from each vendor) =======================
# Email (OTP codes, reminders). Without SMTP, email OTP requests fail in production.
SMTP_URL=
SMTP_FROM=Careflow <no-reply@careflow.13.203.3.1.sslip.io>
# SMS gateway (phone OTP + reminders): POSTs JSON with Bearer key.
SMS_API_URL=
SMS_API_KEY=
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# bKash tokenized checkout
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
# SSLCommerz
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# LiveKit (video consultations)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# S3-compatible object storage for documents (optional; falls back to the database when S3_BUCKET is empty)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_KMS_KEY_ID=

# ======================= One-off demo seed only =======================
# Password for demo users created by `prisma/seed.ts` (>= 12 chars). Only used by the seed command.
SEED_PASSWORD=

# PORT / NODE_ENV are set in docker-compose.yml (container 4000 -> host 127.0.0.1:4002).

# ======================= Frontend =======================
# No runtime variables. Build-time values are baked by GitHub Actions:
#   API_INTERNAL_URL=http://careflow-backend:4000  (Next.js proxies /api/* -> backend, /api stripped)
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY             (repo Actions *variable*, optional, Stripe only)
