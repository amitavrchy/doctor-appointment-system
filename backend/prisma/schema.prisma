generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum AppointmentStatus {
  HELD
  PENDING_PAYMENT
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}
model User {
  id String @id @default(cuid())
  email String @unique
  phone String? @unique
  phoneVerifiedAt DateTime?
  passwordHash String
  fullName String
  globalRole String @default("PATIENT")
  dateOfBirth DateTime?
  bloodGroup String?
  allergies String[]
  emergencyContact Json?
  consentHistory Boolean @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  doctor DoctorProfile?
  roles UserClinicRole[]
  appointments Appointment[] @relation("patient")
  sessions RefreshSession[]
  notificationPreference NotificationPreference?
  carePlansAsPatient CarePlan[] @relation("planPatient")
  carePlansAsDoctor CarePlan[] @relation("planDoctor")
  consentGiven ConsentGrant[] @relation("consentPatient")
  consentReceived ConsentGrant[] @relation("consentDoctor")
  templates ClinicalTemplate[]
}
model DoctorProfile {
  userId String @id
  user User @relation(fields:[userId], references:[id])
  specialties String[]
  licenseNumber String @unique
  bio String
  languages String[]
  color String @default("teal")
  memberships DoctorClinic[]
  rules DoctorScheduleRule[]
  exceptions ScheduleException[]
  appointments Appointment[] @relation("doctor")
  signingCredential DoctorSigningCredential?
  receivedReferrals Referral[]
}
model Clinic {
  id String @id @default(cuid())
  name String
  slug String @unique
  timezone String @default("Asia/Dhaka")
  address String
  lat Float?
  lng Float?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  rooms Room[]
  members UserClinicRole[]
  doctors DoctorClinic[]
  rules DoctorScheduleRule[]
  exceptions ScheduleException[]
  appointments Appointment[]
  phone String?
  fullRefundHours Int @default(24)
  partialRefundHours Int @default(2)
  partialRefundPercent Int @default(50)
  noShowGraceMinutes Int @default(30)
  allowPayLater Boolean @default(true)
  taxBasisPoints Int @default(0)
  invoicePrefix String @default("CF")
  services ClinicService[]
  carePlans CarePlan[]
}
model Room {
  id String @id @default(cuid())
  clinicId String
  name String
  clinic Clinic @relation(fields:[clinicId],references:[id])
  @@unique([clinicId,name])
  active Boolean @default(true)
}
model UserClinicRole {
  id String @id @default(cuid())
  userId String
  clinicId String
  role String
  user User @relation(fields:[userId],references:[id])
  clinic Clinic @relation(fields:[clinicId],references:[id])
  @@unique([userId,clinicId,role])
}
model DoctorClinic {
  id String @id @default(cuid())
  doctorId String
  clinicId String
  feeMinor Int
  teleFeeMinor Int
  doctor DoctorProfile @relation(fields:[doctorId],references:[userId])
  clinic Clinic @relation(fields:[clinicId],references:[id])
  @@unique([doctorId,clinicId])
}
model DoctorScheduleRule {
  id String @id @default(cuid())
  doctorId String
  clinicId String
  rrule String
  startTimeLocal String
  endTimeLocal String
  slotDurationMinutes Int @default(30)
  bufferMinutes Int @default(0)
  maxParallel Int @default(1)
  effectiveFrom DateTime
  effectiveTo DateTime?
  roomId String?
  consultationType String @default("IN_PERSON")
  feeMinor Int
  doctor DoctorProfile @relation(fields:[doctorId],references:[userId])
  clinic Clinic @relation(fields:[clinicId],references:[id])
  @@index([doctorId,clinicId])
  active Boolean @default(true)
  updatedAt DateTime @default(now()) @updatedAt
}
model ScheduleException {
  id String @id @default(cuid())
  doctorId String
  clinicId String
  dateLocal DateTime @db.Date
  type String
  startTimeLocal String?
  endTimeLocal String?
  reason String?
  seriesId String?
  doctor DoctorProfile @relation(fields:[doctorId],references:[userId])
  clinic Clinic @relation(fields:[clinicId],references:[id])
  @@index([doctorId,clinicId,dateLocal])
}
model SlotHold {
  id String @id @default(cuid())
  doctorId String
  clinicId String
  patientId String
  startAt DateTime
  endAt DateTime
  type String
  feeMinor Int
  roomId String?
  baseFeeMinor Int?
  taxMinor Int @default(0)
  addons Json @default("[]")
  refundPolicy Json?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@unique([doctorId,startAt])
  @@index([expiresAt])
}
model Appointment {
  id String @id @default(cuid())
  clinicId String
  doctorId String
  patientId String
  roomId String?
  type String
  status AppointmentStatus @default(CONFIRMED)
  startAt DateTime
  endAt DateTime
  feeMinor Int
  currency String @default("BDT")
  reason String?
  cancelReason String?
  checkedInAt DateTime?
  startedAt DateTime?
  completedAt DateTime?
  priority Int @default(0)
  queueNumber Int?
  queueDate String?
  baseFeeMinor Int?
  taxMinor Int @default(0)
  addons Json @default("[]")
  refundPolicy Json?
  rescheduledFromId String? @unique
  idempotencyKey String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  clinic Clinic @relation(fields:[clinicId],references:[id])
  doctor DoctorProfile @relation("doctor",fields:[doctorId],references:[userId])
  patient User @relation("patient",fields:[patientId],references:[id])
  notes ClinicalNote[]
  prescription Prescription?
  payment Payment?
  teleSession TelemedicineSession?
  attachments Attachment[]
  vitals Vital[]
  labOrders LabOrder[]
  referrals Referral[]
  conflicts AppointmentConflict[]
  messages ConsultationMessage[]
  invoice Invoice?
  @@index([doctorId,startAt])
  @@index([clinicId,status])
  @@index([patientId,startAt])
  @@unique([clinicId,queueDate,queueNumber])
  @@index([status,completedAt])
}
model ClinicalNote {
  id String @id @default(cuid())
  appointmentId String
  authorId String
  soap Json
  searchVector Unsupported("tsvector")?
  createdAt DateTime @default(now())
  appointment Appointment @relation(fields:[appointmentId],references:[id])
  revisions NoteRevision[]
}
model NoteRevision {
  id String @id @default(cuid())
  noteId String
  soap Json
  editedBy String
  editedAt DateTime @default(now())
  note ClinicalNote @relation(fields:[noteId],references:[id])
}
model Prescription {
  id String @id @default(cuid())
  appointmentId String @unique
  doctorId String
  status String @default("DRAFT")
  items Json
  signedAt DateTime?
  expiresAt DateTime?
  verificationCode String @unique @default(cuid())
  signature String?
  appointment Appointment @relation(fields:[appointmentId],references:[id])
}
model Payment {
  id String @id @default(cuid())
  appointmentId String @unique
  provider String
  status String @default("CREATED")
  amountMinor Int
  currency String @default("BDT")
  providerRef String? @unique
  idempotencyKey String @unique
  refundMinor Int @default(0)
  createdAt DateTime @default(now())
  checkoutUrl String?
  providerTransactionId String? @unique
  paidAt DateTime?
  refundedAt DateTime?
  refundReference String?
  lastReconciledAt DateTime?
  appointment Appointment @relation(fields:[appointmentId],references:[id])
}
model WebhookEvent {
  id String @id
  processedAt DateTime @default(now())
}
model TelemedicineSession {
  id String @id @default(cuid())
  appointmentId String @unique
  provider String
  roomName String @unique
  status String @default("SCHEDULED")
  recordingConsent Boolean @default(false)
  startedAt DateTime?
  endedAt DateTime?
  appointment Appointment @relation(fields:[appointmentId],references:[id])
}
model RefreshSession {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  device String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id])
}
model OtpChallenge {
  id String @id @default(cuid())
  email String?
  phone String?
  channel String @default("EMAIL")
  purpose String @default("LOGIN")
  userId String?
  hash String
  attempts Int @default(0)
  expiresAt DateTime
}
model AuditLog {
  id String @id @default(cuid())
  actorId String?
  clinicId String?
  action String
  entity String
  entityId String?
  createdAt DateTime @default(now())
  @@index([clinicId,createdAt])
}
model Notification {
  id String @id @default(cuid())
  userId String
  title String
  body String
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId,createdAt])
}
model WaitlistEntry {
  id String @id @default(cuid())
  doctorId String
  clinicId String
  patientId String
  preferredStart DateTime?
  preferredEnd DateTime?
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  @@index([doctorId,clinicId,status])
}
model Attachment {
  id String @id @default(cuid())
  appointmentId String
  uploadedBy String
  name String
  mime String
  size Int
  encrypted Bytes
  storageKey String?
  createdAt DateTime @default(now())
  appointment Appointment @relation(fields:[appointmentId],references:[id])
  @@index([appointmentId])
}
model Vital {
  id String @id @default(cuid())
  appointmentId String
  authorId String
  systolic Int?
  diastolic Int?
  pulse Int?
  temperature Float?
  oxygen Float?
  weight Float?
  createdAt DateTime @default(now())
  appointment Appointment @relation(fields:[appointmentId],references:[id])
  @@index([appointmentId])
}
model PdfArtifact {
  id String @id
  bytes Bytes
  createdAt DateTime @default(now())
}
model FeatureFlag {
  key String @id
  enabled Boolean @default(true)
  updatedAt DateTime @default(now()) @updatedAt
}
model ClinicQueueCounter {
  id String @id
  value Int @default(0)
}
model ClinicService {
  id String @id @default(cuid())
  clinicId String
  name String
  feeMinor Int
  active Boolean @default(true)
  clinic Clinic @relation(fields:[clinicId],references:[id])
  @@unique([clinicId,name])
}
model Invoice {
  id String @id @default(cuid())
  appointmentId String @unique
  number String @unique
  subtotalMinor Int
  taxMinor Int
  totalMinor Int
  currency String @default("BDT")
  snapshot Json
  issuedAt DateTime @default(now())
  appointment Appointment @relation(fields:[appointmentId],references:[id])
}
model LedgerEntry {
  id String @id @default(cuid())
  journalId String
  clinicId String
  paymentId String
  account String
  side String
  amountMinor Int
  currency String @default("BDT")
  createdAt DateTime @default(now())
  @@unique([journalId,account,side])
  @@index([clinicId,createdAt])
  @@index([paymentId])
}
model ReconciliationRun {
  id String @id @default(cuid())
  clinicId String
  actorId String
  provider String
  status String @default("PENDING")
  checked Int @default(0)
  repaired Int @default(0)
  errors Int @default(0)
  startedAt DateTime @default(now())
  completedAt DateTime?
  @@index([status,startedAt])
}
model AppointmentConflict {
  id String @id @default(cuid())
  appointmentId String
  sourceId String
  reason String
  status String @default("OPEN")
  resolvedBy String?
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  appointment Appointment @relation(fields:[appointmentId],references:[id])
  @@unique([appointmentId,sourceId])
}
model OutboxEvent {
  id String @id @default(cuid())
  type String
  aggregateId String
  clinicId String?
  userId String?
  payload Json
  processedAt DateTime?
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  createdAt DateTime @default(now())
  @@index([processedAt,nextAttemptAt])
}
model NotificationPreference {
  userId String @id
  email Boolean @default(true)
  sms Boolean @default(false)
  inApp Boolean @default(true)
  reminders Boolean @default(true)
  followUps Boolean @default(true)
  user User @relation(fields:[userId],references:[id])
}
model ConsentGrant {
  id String @id @default(cuid())
  patientId String
  doctorId String
  scope String @default("CROSS_CLINIC_HISTORY")
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  patient User @relation("consentPatient",fields:[patientId],references:[id])
  doctor User @relation("consentDoctor",fields:[doctorId],references:[id])
  @@index([patientId,doctorId,revokedAt])
}
model ClinicalTemplate {
  id String @id @default(cuid())
  authorId String
  clinicId String
  title String
  specialty String?
  soap Json
  shared Boolean @default(false)
  author User @relation(fields:[authorId],references:[id])
  @@index([clinicId,authorId])
}
model CarePlan {
  id String @id @default(cuid())
  patientId String
  doctorId String
  clinicId String
  title String
  description String
  status String @default("ACTIVE")
  reviewAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  patient User @relation("planPatient",fields:[patientId],references:[id])
  doctor User @relation("planDoctor",fields:[doctorId],references:[id])
  clinic Clinic @relation(fields:[clinicId],references:[id])
  tasks CarePlanTask[]
  @@index([patientId,status])
}
model CarePlanTask {
  id String @id @default(cuid())
  planId String
  title String
  dueAt DateTime?
  completedAt DateTime?
  completedBy String?
  plan CarePlan @relation(fields:[planId],references:[id])
}
model LabOrder {
  id String @id @default(cuid())
  appointmentId String
  title String
  tests Json
  status String @default("ORDERED")
  results Json?
  resultAttachmentId String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  appointment Appointment @relation(fields:[appointmentId],references:[id])
}
model Referral {
  id String @id @default(cuid())
  appointmentId String
  targetDoctorId String?
  specialty String
  reason String
  status String @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  appointment Appointment @relation(fields:[appointmentId],references:[id])
  targetDoctor DoctorProfile? @relation(fields:[targetDoctorId],references:[userId])
}
model ConsultationMessage {
  id String @id @default(cuid())
  appointmentId String
  authorId String
  text String
  createdAt DateTime @default(now())
  appointment Appointment @relation(fields:[appointmentId],references:[id])
  @@index([appointmentId,createdAt])
}
model DoctorSigningCredential {
  doctorId String @id
  pinHash String
  updatedAt DateTime @default(now()) @updatedAt
  doctor DoctorProfile @relation(fields:[doctorId],references:[userId])
}
