{
  "name": "@careflow/api",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "npm run build && node --watch dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/platform-socket.io": "^12.3.2",
    "@nestjs/websockets": "^12.3.2",
    "@prisma/client": "^6.19.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.63.0",
    "cookie-parser": "^1.4.7",
    "deepmerge-ts": "^8.0.2",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "livekit-server-sdk": "^2.14.0",
    "luxon": "^3.7.2",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.3",
    "@types/pdfkit": "^0.17.3",
    "@types/qrcode": "^1.5.6",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "vitest": "^5.1.0"
  }
}
